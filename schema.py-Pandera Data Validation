import pandera as pa
from pandera import Column, Check

loan_schema = pa.DataFrameSchema({
    "loan_id": Column(int, nullable=False, unique=True),
    "income": Column(float, Check.greater_than(0)),
    "loan_amount": Column(float, Check.greater_than(0)),
    "credit_score": Column(int, Check.in_range(300, 850)),
    "employment_years": Column(float, Check.greater_than_or_equal_to(0)),
    "debt_to_income": Column(float, Check.in_range(0, 1)),
})
